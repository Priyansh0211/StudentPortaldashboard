<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - IGNOU Student Portal</title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ignou.styles.css"
          asp-append-version="true" />

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var isDashboard = currentController == "StudentDashboard";
}


@if (!isDashboard)
{
    <!-- ================= NAVBAR ================= -->

    <header>
        <nav class="portal-navbar">

            <div class="navbar-container">

                <!-- Brand -->
                <a class="portal-brand"
                   asp-controller="Account"
                   asp-action="Register">

                    <div class="brand-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>

                    <div class="brand-text">
                        <strong>IGNOU</strong>
                        <span>Student Portal</span>
                    </div>

                </a>


                <!-- Mobile Menu Button -->
                <button class="mobile-menu-btn"
                        type="button"
                        id="mobileMenuBtn"
                        aria-label="Toggle navigation">

                    <i class="fa-solid fa-bars"></i>

                </button>


                <!-- Navigation -->
                <div class="navbar-links"
                     id="navbarLinks">

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="nav-link-custom">

                        <i class="fa-solid fa-user-plus"></i>

                        <span>Register</span>

                    </a>


                    <a asp-controller="Account"
                       asp-action="Login"
                       class="nav-link-custom">

                        <i class="fa-solid fa-right-to-bracket"></i>

                        <span>Login</span>

                    </a>

                </div>

            </div>

        </nav>
    </header>
}


<!-- ================= PAGE CONTENT ================= -->

<main role="main">

    @RenderBody()

</main>


@if (!isDashboard)
{
    <!-- ================= FOOTER ================= -->

    <footer class="portal-footer">

        <div class="footer-left">

            <strong>
                <i class="fa-solid fa-graduation-cap"></i>
                IGNOU Student Portal
            </strong>

            <span>
                © @DateTime.Now.Year All rights reserved.
            </span>

        </div>


        <div class="footer-links">

            <a href="#">
                Privacy Policy
            </a>

            <a href="#">
                Help & Support
            </a>

        </div>

    </footer>
}


<!-- ================= SCRIPTS ================= -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>


<!-- Mobile Navbar -->
<script>

    document.addEventListener("DOMContentLoaded", function () {

        const menuButton =
            document.getElementById("mobileMenuBtn");

        const navbarLinks =
            document.getElementById("navbarLinks");


        if (menuButton && navbarLinks) {

            menuButton.addEventListener("click", function () {

                navbarLinks.classList.toggle("show");

                const icon =
                    menuButton.querySelector("i");


                if (navbarLinks.classList.contains("show")) {

                    icon.classList.remove("fa-bars");
                    icon.classList.add("fa-xmark");

                }
                else {

                    icon.classList.remove("fa-xmark");
                    icon.classList.add("fa-bars");

                }

            });

        }

    });

</script>


<!-- ================= REGISTRATION SUCCESS POPUP ================= -->

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            Swal.fire({
                icon: "success",
                title: "Registration Successful!",
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    TempData["SuccessMessage"]?.ToString()
                )),
                confirmButtonText: "Continue to Login",
                confirmButtonColor: "#176ff5",
                allowOutsideClick: false,
                allowEscapeKey: false,
                customClass: {
                    popup: "ignou-success-popup",
                    confirmButton: "ignou-success-button"
                }
            }).then(function (result) {

                if (result.isConfirmed) {

                    window.location.assign(
                        "/Account/Login"
                    );
                }
            });

        });
    </script>
}

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>