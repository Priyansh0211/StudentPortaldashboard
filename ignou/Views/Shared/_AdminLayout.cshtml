<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Student Portal</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Common Student Layout CSS -->
    <link rel="stylesheet"
          href="~/css/AdminLayout.css"
          asp-append-version="true" />

    @RenderSection("Styles", required: false)

</head>

<body>

    <div class="student-portal">

        <!-- ========================= -->
        <!-- TOP NAVBAR -->
        <!-- ========================= -->

        <header class="student-navbar">

            <div class="student-brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>

                <div>
                    <h5>Admin Portal</h5>
                    <span>Academic Management System - VMOU</span>
                </div>

            </div>


            <div class="student-navbar-right">

                <!-- Notification -->

                <button class="notification-btn">

                    <i class="fa-regular fa-bell"></i>

                    <span class="notification-dot">
                        3
                    </span>

                </button>


                @* Admin *@

                <div class="navbar-student">

                    <div class="navbar-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div class="navbar-student-info">

                        <strong>
                            @User.Identity?.Name
                        </strong>

                        <span>
                            Admin
                        </span>

                    </div>

                </div>

            </div>

        </header>


        <!-- ========================= -->
        <!-- MAIN AREA -->
        <!-- ========================= -->

        <div class="student-main">


            <!-- ========================= -->
            <!-- SIDEBAR -->
            <!-- ========================= -->

            <aside class="student-sidebar">


                <!-- Student Info -->

                <div class="sidebar-student">

                    <div class="sidebar-avatar">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>

                    <div>

                        <strong>
                            @User.Identity?.Name
                        </strong>

                        <span>
                            Active Admin
                        </span>

                    </div>

                </div>


                <!-- Menu Heading -->

                <div class="sidebar-heading">
                    MAIN MENU
                </div>


                <!-- Navigation -->

                <nav class="student-menu">


                    <!-- Dashboard -->

                    <a asp-controller="AdminDashboard"
                       asp-action="Dashboard"
                       class="student-menu-link">

                        <i class="fa-solid fa-house"></i>

                        <span>
                            Dashboard
                        </span>

                    </a>


                    <!-- Profile -->

                    <a asp-controller="AdminDashboard"
                       asp-action="Profile"
                       class="student-menu-link">

                        <i class="fa-regular fa-user"></i>

                        <span>
                            My Profile
                        </span>

                    </a>


                     <!-- Students -->

                    <a asp-controller="AdminDashboard"
                       asp-action="GetAllStudents"
                       class="student-menu-link">

                        <i class="fa-solid fa-user-graduate"></i>

                        <span>
                            Students
                        </span>

                    </a>



                    <!-- Announcement -->

                    <a asp-action="ManageAnnouncements"
                    asp-controller="Announcement"
                       class="student-menu-link">

                        <i class="fa-solid fa-file-pen"></i>

                        <span>
                            Announcement
                        </span>

                    </a>


                    <!-- Results -->

                    <a href="#"
                       class="student-menu-link">

                        <i class="fa-solid fa-chart-column"></i>

                        <span>
                            Results
                        </span>

                    </a>




                    

                    <!-- Support -->

                    <div class="sidebar-heading support-heading">
                        SUPPORT
                    </div>


                    <a href="#"
                       class="student-menu-link">

                        <i class="fa-solid fa-circle-question"></i>

                        <span>
                            Help & Support
                        </span>

                    </a>

                </nav>


                <!-- Logout -->

                <div class="sidebar-logout">

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="logout-button">

                            <i class="fa-solid fa-right-from-bracket"></i>

                            <span>
                                Sign Out
                            </span>

                        </button>

                    </form>

                </div>

            </aside>


            <!-- ========================= -->
            <!-- PAGE CONTENT -->
            <!-- ========================= -->

            <main class="student-content">

                @RenderBody()

            </main>

        </div>


        <!-- ========================= -->
        <!-- FOOTER -->
        <!-- ========================= -->

        <footer class="student-footer">

            <span>
                © @DateTime.Now.Year Student Portal
            </span>

            <span>
                Academic Management System
            </span>

        </footer>

    </div>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>