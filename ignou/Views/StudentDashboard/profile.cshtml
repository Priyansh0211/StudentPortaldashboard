@model ignou.Models.User
@{
    ViewData["Title"] = "My Profile";

    Layout = "_StudentLayout";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-primary"><i class="bi bi-person-lines-fill me-2"></i> Student Profile</h3>
    </div>

    <div class="row">
        <!-- Basic Info Card -->
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="bi bi-person-circle text-secondary" style="font-size: 5rem;"></i>
                    <h4 class="mt-3 fw-bold">@Model.FullName</h4>
                    <p class="text-muted mb-1">@Model.ProgramName (@Model.ProgramType)</p>
                    <span class="badge bg-success px-3 py-2 mt-2">Active Student</span>
                </div>
            </div>
        </div>

        <!-- Right Side: Detailed Info -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary border-bottom fw-bold text-white">
                    <i class="bi bi-info-circle me-1"></i> Personal Details
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Email ID:</div>
                        <div class="col-sm-8 fw-semibold">@Model.Email</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Mobile Number:</div>
                        <div class="col-sm-8 fw-semibold">@Model.MobileNo</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Father's Name:</div>
                        <div class="col-sm-8 fw-semibold  text-capitalize">@Model.FatherName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Date of Birth:</div>
                        <div class="col-sm-8 fw-semibold">
                            @(Model.DOB != DateTime.MinValue ? Model.DOB.ToString("dd-MMM-yyyy") : "N/A")
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Gender:</div>
                        <div class="col-sm-8 fw-semibold  text-capitalize">@Model.Gender</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Aadhaar Number:</div>
                        <div class="col-sm-8 fw-semibold  text-capitalize">@Model.AadhaarNo</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Marital Status:</div>
                        <div class="col-sm-8 fw-semibold  text-capitalize">@Model.MaritalStatus</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Personal Personal Disability:</div>
                        <div class="col-sm-8 fw-semibold  text-capitalize">@Model.PersonalDisability</div>
                    </div>
                </div>
            </div>

            <!-- Address Card -->
            <div class="card shadow-sm border-0 mt-4">
                <div class="card-header bg-primary border-bottom fw-bold text-white">
                    <i class="bi bi-geo-alt me-1"></i> Address Details
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">House No:</div>
                        <div class="col-sm-8 fw-semibold  text-capitalize">
                            @Model.House
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">City:</div>
                        <div class="col-sm-8 fw-semibold text-capitalize">
                            @Model.City
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">District:</div>
                        <div class="col-sm-8 fw-semibold text-capitalize">

                            @Model.District
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">State:</div>
                        <div class="col-sm-8 fw-semibold text-capitalize">
                            @Model.State
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">PinCode:</div>
                        <div class="col-sm-8 fw-semibold text-capitalize">
                            @Model.Pincode
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>