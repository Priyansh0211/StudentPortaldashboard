@model ignou.Models.User

@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />
}

<!-- PAGE HEADER -->

<div class="dashboard-header">

    <div>
        <h1>Dashboard</h1>

        <p>
            Welcome back, @Model.FullName!
            Here's your academic overview.
        </p>
    </div>

    <div class="academic-session">

        <i class="fa-regular fa-calendar"></i>

        <span>
            Academic Session 2026
        </span>

    </div>

</div>


<!-- WELCOME CARD -->

<div class="dashboard-welcome">

    <div class="welcome-content">

        <span class="welcome-small">
            Welcome back 👋
        </span>

        <h2>
            Hello, @Model.FullName!
        </h2>

        <p>
            Manage your student profile and academic activities
            from your student dashboard.
        </p>

    </div>

    <div class="welcome-icon">

        <i class="fa-solid fa-graduation-cap"></i>

    </div>

</div>

<!-- OVERVIEW -->

<div class="dashboard-section-title">

    <div>

        <h3>
            Overview
        </h3>

        <p>
            Your current student information
        </p>

    </div>

</div>


<div class="row g-4">


    <!-- Student -->

    <div class="col-lg-4 col-md-6">

        <div class="overview-card">

            <div class="overview-icon blue">

                <i class="fa-solid fa-user"></i>

            </div>

            <div>

                <span>
                    Student Name
                </span>

                <h4>
                    @Model.FullName
                </h4>

            </div>

        </div>

    </div>


    <!-- Email -->

    <div class="col-lg-4 col-md-6">

        <div class="overview-card">

            <div class="overview-icon purple">

                <i class="fa-solid fa-envelope"></i>

            </div>

            <div>

                <span>
                    Email Address
                </span>

                <h4>
                    @Model.Email
                </h4>

            </div>

        </div>

    </div>


    <!-- Program -->

    <div class="col-lg-4 col-md-6">

        <div class="overview-card">

            <div class="overview-icon green">

                <i class="fa-solid fa-graduation-cap"></i>

            </div>

            <div>

                <span>
                    Program
                </span>

                <h4>
                    @Model.ProgramName
                </h4>

            </div>

        </div>

    </div>

</div>


<!-- QUICK ACTIONS -->

<div class="dashboard-section-title quick-title">

    <div>

        <h3>
            Quick Actions
        </h3>

        <p>
            Access your important student sections
        </p>

    </div>

</div>


<div class="row g-4">


    <!-- Profile -->

    <div class="col-lg-4 col-md-6">

        <a asp-controller="StudentDashboard"
           asp-action="Profile"
           class="quick-action-card">

            <div class="quick-action-icon">

                <i class="fa-regular fa-user"></i>

            </div>

            <div class="quick-action-content">

                <h4>
                    My Profile
                </h4>

                <p>
                    View your personal information
                </p>

            </div>

            <i class="fa-solid fa-arrow-right action-arrow"></i>

        </a>

    </div>


    <!-- Program -->

    <div class="col-lg-4 col-md-6">

        <a asp-controller="StudentDashboard"
           asp-action="Program"
           class="quick-action-card">

            <div class="quick-action-icon">

                <i class="fa-solid fa-graduation-cap"></i>

            </div>

            <div class="quick-action-content">

                <h4>
                    My Program
                </h4>

                <p>
                    View your academic program
                </p>

            </div>

            <i class="fa-solid fa-arrow-right action-arrow"></i>

        </a>

    </div>


    <!-- Assignments -->

    <div class="col-lg-4 col-md-6">

        <a href="#"
           class="quick-action-card">

            <div class="quick-action-icon">

                <i class="fa-solid fa-book-open"></i>

            </div>

            <div class="quick-action-content">

                <h4>
                    Assignments
                </h4>

                <p>
                    Check your assignments
                </p>

            </div>

            <i class="fa-solid fa-arrow-right action-arrow"></i>

        </a>

    </div>

</div>


<!-- BASIC ACADEMIC INFORMATION -->

<div class="dashboard-section-title academic-title">

    <div>

        <h3>
            Academic Information
        </h3>

        <p>
            Your registered academic details
        </p>

    </div>

</div>


<div class="academic-card">

    <div class="academic-item">

        <span>
            Program Type
        </span>

        <strong>
            @Model.ProgramType
        </strong>

    </div>


    <div class="academic-divider"></div>


    <div class="academic-item">

        <span>
            Program Name
        </span>

        <strong>
            @Model.ProgramName
        </strong>

    </div>

    <div class="academic-divider"></div>


    <div class="academic-item">

        <span>
            Student Status
        </span>

        <strong class="active-status">
            Active
        </strong>

    </div>

</div>