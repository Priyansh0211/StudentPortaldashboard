@{
    ViewData["Title"] = "Home - Vardhman Mahaveer Open University";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />
</head>

<body>

    <!-- University Header -->
    <header class="university-header">
        <div class="university-header-inner">
            <img src="~/images/vmou-header.png"
                 alt="Vardhman Mahaveer Open University"
                 class="university-header-banner" />
        </div>
    </header>

    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg vmou-navbar">
        <div class="container-fluid px-lg-4">

            <a class="navbar-brand d-lg-none text-white"
               href="@Url.Action("Index", "Home")">
                VMOU
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#vmouNavbar"
                    aria-controls="vmouNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="vmouNavbar">
                <ul class="navbar-nav w-100 justify-content-between">

                    <li class="nav-item">
                        <a class="nav-link active"
                           href="@Url.Action("Index", "Home")">
                            HOME
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"
                           href="#university"
                           role="button"
                           data-bs-toggle="dropdown">
                            UNIVERSITY
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#university">About University</a></li>
                            <li><a class="dropdown-item" href="#university">Vision & Mission</a></li>
                            <li><a class="dropdown-item" href="#contact">Contact Information</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"
                           href="#student-services"
                           role="button"
                           data-bs-toggle="dropdown">
                            STUDENT E-CORNER
                        </a>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item"
                                   href="@Url.Action("Register", "Account")">
                                    Student Registration
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   href="@Url.Action("Login", "Account")">
                                    Student Login
                                </a>
                            </li>
                            <li><a class="dropdown-item" href="#student-services">Student Services</a></li>
                        </ul>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#programmes">SCHOOLS</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#regional-centres">REGIONAL CENTRES</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#programmes">PROGRAMMES</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#notices">NOTICES</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#contact">CONTACT</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#faqs">FAQS</a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <main>

        <!-- Campus Image Slider -->
        <section class="hero-section">
            <div id="vmouCarousel"
                 class="carousel slide carousel-fade"
                 data-bs-ride="carousel">

                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#vmouCarousel"
                            data-bs-slide-to="0" class="active"
                            aria-current="true" aria-label="Slide 1"></button>

                    <button type="button" data-bs-target="#vmouCarousel"
                            data-bs-slide-to="1" aria-label="Slide 2"></button>

                    <button type="button" data-bs-target="#vmouCarousel"
                            data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>

                <div class="carousel-inner">

                    <div class="carousel-item active">
                        <img src="https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=1800&q=85"
                             class="d-block w-100 hero-image"
                             alt="University campus building" />

                        <div class="carousel-caption hero-caption">
                            <span class="hero-kicker">WELCOME TO VMOU</span>
                            <h2>Education Without Boundaries</h2>
                            <p>Explore learning opportunities and build your future with open education.</p>

                            <div class="hero-buttons">
                                <a href="@Url.Action("Register", "Account")"
                                   class="btn btn-warning btn-lg">
                                    <i class="fa-solid fa-user-plus me-2"></i>
                                    Register Now
                                </a>

                                <a href="@Url.Action("Login", "Account")"
                                   class="btn btn-outline-light btn-lg">
                                    <i class="fa-solid fa-right-to-bracket me-2"></i>
                                    Student Login
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="carousel-item">
                        <img src="https://images.unsplash.com/photo-1564981797816-1043664bf78d?auto=format&fit=crop&w=1800&q=85"
                             class="d-block w-100 hero-image"
                             alt="University campus" />

                        <div class="carousel-caption hero-caption">
                            <span class="hero-kicker">YOUR LEARNING JOURNEY</span>
                            <h2>Learn at Your Own Pace</h2>
                            <p>Access your student services and academic information in one place.</p>

                            <div class="hero-buttons">
                                <a href="@Url.Action("Register", "Account")"
                                   class="btn btn-warning btn-lg">
                                    Register Now
                                </a>

                                <a href="@Url.Action("Login", "Account")"
                                   class="btn btn-outline-light btn-lg">
                                    Student Login
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="carousel-item">
                        <img src="https://images.unsplash.com/photo-1498243691581-b145c3f54a5a?auto=format&fit=crop&w=1800&q=85"
                             class="d-block w-100 hero-image"
                             alt="Academic library and learning resources" />

                        <div class="carousel-caption hero-caption">
                            <span class="hero-kicker">STUDENT SERVICES</span>
                            <h2>Your Academic Journey, Simplified</h2>
                            <p>Stay informed about programmes, assignments, examinations and results.</p>

                            <div class="hero-buttons">
                                <a href="#student-services"
                                   class="btn btn-warning btn-lg">
                                    Explore Services
                                </a>

                                <a href="@Url.Action("Login", "Account")"
                                   class="btn btn-outline-light btn-lg">
                                    Student Login
                                </a>
                            </div>
                        </div>
                    </div>

                </div>

                <button class="carousel-control-prev"
                        type="button"
                        data-bs-target="#vmouCarousel"
                        data-bs-slide="prev"
                        aria-label="Previous slide">
                    <span class="carousel-control-prev-icon"></span>
                </button>

                <button class="carousel-control-next"
                        type="button"
                        data-bs-target="#vmouCarousel"
                        data-bs-slide="next"
                        aria-label="Next slide">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </section>

        <!-- Welcome Section -->
        <section class="welcome-section section-space" id="university">
            <div class="container">
                <div class="row align-items-center g-4">

                    <div class="col-lg-8">
                        <span class="section-kicker">ABOUT THE UNIVERSITY</span>
                        <h2 class="section-title">
                            Welcome to Vardhman Mahaveer Open University
                        </h2>

                        <p class="section-description">
                            Discover an accessible and flexible learning experience.
                            This student portal brings important academic information
                            and student services together in one convenient place.
                        </p>

                        <a href="#student-services" class="text-link">
                            Explore Student Services
                            <i class="fa-solid fa-arrow-right ms-2"></i>
                        </a>
                    </div>

                    <div class="col-lg-4">
                        <div class="welcome-highlight">
                            <div class="highlight-icon">
                                <i class="fa-solid fa-book-open-reader"></i>
                            </div>
                            <h3>Learning Made Accessible</h3>
                            <p>
                                Find programme information and access your student
                                portal whenever you need it.
                            </p>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- Student Services -->
        <section class="services-section section-space" id="student-services">
            <div class="container">

                <div class="section-heading text-center">
                    <span class="section-kicker">STUDENT E-CORNER</span>
                    <h2 class="section-title">Student Services</h2>
                    <p class="section-description">
                        Quick access to essential student information and services.
                    </p>
                </div>

                <div class="row g-4 mt-2">

                    <div class="col-sm-6 col-lg-3">
                        <div class="service-card">
                            <div class="service-icon">
                                <i class="fa-solid fa-user-graduate"></i>
                            </div>
                            <h3>Student Registration</h3>
                            <p>Create your student account to access the portal.</p>
                            <a href="@Url.Action("Register", "Account")">
                                Register Now <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="service-card">
                            <div class="service-icon">
                                <i class="fa-solid fa-book-open"></i>
                            </div>
                            <h3>Assignments</h3>
                            <p>Access assignment information through your account.</p>
                            <a href="@Url.Action("Login", "Account")">
                                Student Login <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="service-card">
                            <div class="service-icon">
                                <i class="fa-solid fa-file-circle-check"></i>
                            </div>
                            <h3>Examinations & Results</h3>
                            <p>Visit your account to view available academic updates.</p>
                            <a href="@Url.Action("Login", "Account")">
                                View Portal <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="service-card">
                            <div class="service-icon">
                                <i class="fa-solid fa-headset"></i>
                            </div>
                            <h3>Help & Support</h3>
                            <p>Find answers to common student questions.</p>
                            <a href="#faqs">
                                Get Help <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- Regional Centres -->
        <section class="regional-section section-space" id="regional-centres">
            <div class="container">

                <div class="section-heading">
                    <span class="section-kicker">OUR NETWORK</span>
                    <h2 class="section-title">Regional Centres</h2>
                    <p class="section-description">
                        Find regional centre information and local student assistance.
                    </p>
                </div>

                <div class="row g-4 mt-2">

                    <div class="col-md-4">
                        <div class="regional-card">
                            <img src="https://images.unsplash.com/photo-1562774053-701939374585?auto=format&fit=crop&w=800&q=80"
                                 alt="University building" />
                            <div class="regional-card-body">
                                <h3>Kota</h3>
                                <p>Regional centre information</p>
                                <a href="https://www.vmou.ac.in/"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Visit Official Website
                                    <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="regional-card">
                            <img src="https://images.unsplash.com/photo-1498243691581-b145c3f54a5a?auto=format&fit=crop&w=800&q=80"
                                 alt="Academic learning facility" />
                            <div class="regional-card-body">
                                <h3>Jaipur</h3>
                                <p>Regional centre information</p>
                                <a href="https://www.vmou.ac.in/"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Visit Official Website
                                    <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="regional-card">
                            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQbec7BnproHS80L-trsFx9ROkWFCFkzNbiQO_yHT2fnuB8o3T2yPA2R6bi&s=10"
                                 alt="University campus building" />
                            <div class="regional-card-body">
                                <h3>Bikaner</h3>
                                <p>Regional centre information</p>
                                <a href="https://www.vmou.ac.in/"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Visit Official Website
                                    <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- Programmes -->
        <section class="programmes-section section-space" id="programmes">
            <div class="container">
                <div class="row align-items-center g-4">
                    <div class="col-lg-8">
                        <span class="section-kicker">ACADEMIC INFORMATION</span>
                        <h2 class="section-title">Explore Programmes</h2>
                        <p class="section-description">
                            Learn more about academic programmes and choose the
                            information relevant to your educational goals.
                        </p>
                    </div>

                    <div class="col-lg-4 text-lg-end">
                        <a href="https://www.vmou.ac.in/"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-primary btn-lg">
                            Explore Official Programmes
                            <i class="fa-solid fa-arrow-up-right-from-square ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Notices -->
        <section class="notices-section section-space" id="notices">
            <div class="container">
                <div class="section-heading">
                    <span class="section-kicker">LATEST UPDATES</span>
                    <h2 class="section-title">Notices & Announcements</h2>
                    <p class="section-description">
                        Check official university announcements for current dates
                        and important academic information.
                    </p>
                </div>

                <div class="notice-card mt-4">
                    <div class="notice-icon">
                        <i class="fa-solid fa-bullhorn"></i>
                    </div>

                    <div class="notice-content">
                        <h3>University Notices</h3>
                        <p>
                            For verified admission, examination and result
                            notifications, visit the official university website.
                        </p>
                    </div>

                    <a href="https://www.vmou.ac.in/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-outline-primary">
                        View Notices
                    </a>
                </div>
            </div>
        </section>

        <!-- FAQs -->
        <section class="faq-section section-space" id="faqs">
            <div class="container">
                <div class="section-heading text-center">
                    <span class="section-kicker">NEED ASSISTANCE?</span>
                    <h2 class="section-title">Frequently Asked Questions</h2>
                    <p class="section-description">
                        Quick answers to common student portal questions.
                    </p>
                </div>

                <div class="accordion faq-accordion mt-4" id="faqAccordion">

                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faqOne"
                                    aria-expanded="true"
                                    aria-controls="faqOne">
                                How can I create a student account?
                            </button>
                        </h3>
                        <div id="faqOne"
                             class="accordion-collapse collapse show"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Click Register Now, complete the registration form
                                and then sign in using your registered credentials.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faqTwo"
                                    aria-expanded="false"
                                    aria-controls="faqTwo">
                                How can I access student services?
                            </button>
                        </h3>
                        <div id="faqTwo"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Sign in to your student account to access the
                                services available in your dashboard.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faqThree"
                                    aria-expanded="false"
                                    aria-controls="faqThree">
                                Where can I find official university notices?
                            </button>
                        </h3>
                        <div id="faqThree"
                             class="accordion-collapse collapse"
                             data-bs-parent="#faqAccordion">
                            <div class="accordion-body">
                                Use the Notices section or visit the official
                                VMOU website for verified announcements.
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- Call to Action -->
        <section class="cta-section">
            <div class="container">
                <div class="cta-content">
                    <div>
                        <h2>Ready to access your student portal?</h2>
                        <p>Register for an account or sign in to continue.</p>
                    </div>

                    <div class="cta-buttons">
                        <a href="@Url.Action("Register", "Account")"
                           class="btn btn-warning btn-lg">
                            Register Now
                        </a>

                        <a href="@Url.Action("Login", "Account")"
                           class="btn btn-outline-light btn-lg">
                            Student Login
                        </a>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="vmou-footer" id="contact">
        <div class="container">
            <div class="row g-4">

                <div class="col-md-5">
                    <h3>Vardhman Mahaveer Open University</h3>
                    <p>
                        Student portal for academic information and student services.
                        Visit the official university website for verified
                        institutional information.
                    </p>
                </div>

                <div class="col-md-3">
                    <h4>Quick Links</h4>
                    <a href="@Url.Action("Index", "Home")">Home</a>
                    <a href="#programmes">Programmes</a>
                    <a href="#notices">Notices</a>
                    <a href="#faqs">FAQs</a>
                </div>

                <div class="col-md-4">
                    <h4>Student Account</h4>
                    <a href="@Url.Action("Register", "Account")">Student Registration</a>
                    <a href="@Url.Action("Login", "Account")">Student Login</a>
                    <a href="https://www.vmou.ac.in/"
                       target="_blank"
                       rel="noopener noreferrer">Official VMOU Website</a>
                </div>

            </div>

            <div class="footer-bottom">
                <p>
                    &copy; @DateTime.Now.Year Vardhman Mahaveer Open University
                    Student Portal. Educational project.
                </p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>