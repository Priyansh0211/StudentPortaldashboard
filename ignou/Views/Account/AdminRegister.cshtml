@model ignou.Models.AdminRegisterViewModel

@{
    ViewData["Title"] = "Admin Registration";
}

<div class="registration-page">
    <div class="registration-container">

        <!-- PAGE HEADER -->
        <div class="registration-heading">
            <div>
                <span class="page-kicker">
                    <i class="fa-solid fa-user-shield"></i>
                    ADMIN PORTAL
                </span>
                <h1>Create Admin Account</h1>
                <p>
                    Complete the registration form to create your VNOU Admin / Staff portal account.
                </p>
            </div>
            <div class="secure-badge">
                <i class="fa-solid fa-shield-halved"></i>
                <span>
                    Secure Registration
                    <small>Your information is protected</small>
                </span>
            </div>
        </div>

        

        <!-- VALIDATION SUMMARY -->
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        <!-- REGISTRATION FORM -->
        <form asp-action="AdminRegister" asp-controller="Account" method="post" class="registration-form">
            @Html.AntiForgeryToken()

            <!-- =================================================
                 1. PROFESSIONAL DETAILS (New Section for Admin)
            ================================================== -->
            <section class="registration-card">
                <div class="section-header purple-header">
                    <div class="section-icon">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>
                    <div>
                        <h2>Professional Details</h2>
                        <p>Enter your official staff details</p>
                    </div>
                </div>

                <div class="section-body">
                    <div class="form-grid">

                        @* <!-- Employee ID -->
                        <div class="form-field">
                            <label asp-for="EmployeeId">
                                Employee ID <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-id-badge"></i>
                                <input asp-for="EmployeeId" class="form-control-custom" placeholder="e.g. EMP-101" />
                            </div>
                            <span asp-validation-for="EmployeeId" class="field-validation"></span>
                        </div> *@

                        <!-- Department -->
                        <div class="form-field">
                            <label asp-for="Department">
                                Department <span>*</span>
                            </label>
                            <div class="input-wrapper select-wrapper">
                                <i class="fa-solid fa-building"></i>
                                <select asp-for="Department" class="form-control-custom">
                                    <option value="">Select Department</option>
                                    <option value="Administration">Administration</option>
                                    <option value="Examination">Examination</option>
                                    <option value="IT Cell">IT Cell</option>
                                    <option value="Accounts">Accounts</option>
                                </select>
                            </div>
                            <span asp-validation-for="Department" class="field-validation"></span>
                        </div>

                        <!-- Designation -->
                        <div class="form-field">
                            <label asp-for="Designation">
                                Designation
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-user-tie"></i>
                                <input asp-for="Designation" class="form-control-custom" placeholder="e.g. System Admin" />
                            </div>
                            <span asp-validation-for="Designation" class="field-validation"></span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- =================================================
                 2. PERSONAL DETAILS
             ================================================= -->
            <section class="registration-card">
                <div class="section-header blue-header">
                    <div class="section-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div>
                        <h2>Personal Details</h2>
                        <p>Enter your personal information</p>
                    </div>
                </div>

                <div class="section-body">
                    <div class="form-grid">
                        <div class="form-field">
                            <label asp-for="FullName">
                                Full Name <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-regular fa-user"></i>
                                <input asp-for="FullName" class="form-control-custom" placeholder="Enter your full name" autocomplete="name" />
                            </div>
                            <span asp-validation-for="FullName" class="field-validation"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="FatherName">
                                Father's Name <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-user-tie"></i>
                                <input asp-for="FatherName" class="form-control-custom" placeholder="Enter father's name" />
                            </div>
                            <span asp-validation-for="FatherName" class="field-validation"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="DOB">
                                Date of Birth <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-regular fa-calendar"></i>
                                <input asp-for="DOB" type="date" class="form-control-custom" />
                            </div>
                            <span asp-validation-for="DOB" class="field-validation"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="Gender">
                                Gender <span>*</span>
                            </label>
                            <div class="input-wrapper select-wrapper">
                                <i class="fa-solid fa-venus-mars"></i>
                                <select asp-for="Gender" class="form-control-custom">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <span asp-validation-for="Gender" class="field-validation"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="BloodGroup">
                                Blood Group
                            </label>
                            <div class="input-wrapper select-wrapper">
                                <i class="fa-solid fa-droplet"></i>
                                <select asp-for="BloodGroup" class="form-control-custom">
                                    <option value="">Select Blood Group</option>
                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>
                                </select>
                            </div>
                            <span asp-validation-for="BloodGroup" class="field-validation"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="MaritalStatus">
                                Marital Status
                            </label>
                            <div class="input-wrapper select-wrapper">
                                <i class="fa-solid fa-heart"></i>
                                <select asp-for="MaritalStatus" class="form-control-custom">
                                    <option value="">Select Marital Status</option>
                                    <option value="Single">Single</option>
                                    <option value="Married">Married</option>
                                </select>
                            </div>
                            <span asp-validation-for="MaritalStatus" class="field-validation"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="AadhaarNo">
                                Aadhaar Number <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-id-card"></i>
                                <input asp-for="AadhaarNo" class="form-control-custom" placeholder="Enter 12-digit Aadhaar number" maxlength="12" inputmode="numeric" autocomplete="off" />
                            </div>
                            <span asp-validation-for="AadhaarNo" class="field-validation"></span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- =================================================
                 3. CONTACT & LOGIN DETAILS
            ================================================== -->
            <section class="registration-card">
                <div class="section-header dark-header">
                    <div class="section-icon">
                        <i class="fa-solid fa-address-book"></i>
                    </div>
                    <div>
                        <h2>Contact & Login Details</h2>
                        <p>Use these details to access your account</p>
                    </div>
                </div>

                <div class="section-body">
                    <div class="form-grid">
                        <div class="form-field">
                            <label asp-for="Email">
                                Official Email Address <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-regular fa-envelope"></i>
                                <input asp-for="Email" type="email" class="form-control-custom" placeholder="staff@vnou.ac.in" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="field-validation"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="MobileNo">
                                Mobile Number <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-mobile-screen"></i>
                                <input asp-for="MobileNo" class="form-control-custom" placeholder="Enter 10-digit mobile number" maxlength="10" inputmode="numeric" autocomplete="tel" />
                            </div>
                            <span asp-validation-for="MobileNo" class="field-validation"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="Password">
                                Password <span>*</span>
                            </label>
                            <div class="input-wrapper password-wrapper">
                                <i class="fa-solid fa-lock"></i>
                                <input asp-for="Password" type="password" id="passwordField" class="form-control-custom" placeholder="Create a password" autocomplete="new-password" />
                                @* <button type="button" class="password-toggle" onclick="togglePassword('passwordField', this)" aria-label="Show password">
                                    <i class="fa-regular fa-eye"></i>
                                </button> *@
                            </div>
                            <span asp-validation-for="Password" class="field-validation"></span>
                            <small class="field-hint">Password must meet the minimum security requirements.</small>
                        </div>
                    </div>
                </div>
            </section>

            <!-- =================================================
                 4. ADDRESS DETAILS
            ================================================== -->
            <section class="registration-card">
                <div class="section-header green-header">
                    <div class="section-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div>
                        <h2>Address Details</h2>
                        <p>Enter your current residential address</p>
                    </div>
                </div>

                <div class="section-body">
                    <div class="form-grid">
                        <div class="form-field">
                            <label asp-for="House">
                                House / Street Address <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-house"></i>
                                <input asp-for="House" class="form-control-custom" placeholder="House number, street, locality" />
                            </div>
                            <span asp-validation-for="House" class="field-validation"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="City">
                                City <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-city"></i>
                                <input asp-for="City" class="form-control-custom" placeholder="Enter city" />
                            </div>
                            <span asp-validation-for="City" class="field-validation"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="District">
                                District <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-map-location-dot"></i>
                                <input asp-for="District" class="form-control-custom" placeholder="Enter district" />
                            </div>
                            <span asp-validation-for="District" class="field-validation"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="State">
                                State <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-map"></i>
                                <input asp-for="State" class="form-control-custom" placeholder="Enter state" />
                            </div>
                            <span asp-validation-for="State" class="field-validation"></span>
                        </div>

                        <div class="form-field">
                            <label asp-for="Pincode">
                                Pincode <span>*</span>
                            </label>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-location-crosshairs"></i>
                                <input asp-for="Pincode" class="form-control-custom" placeholder="Enter 6-digit pincode" maxlength="6" inputmode="numeric" />
                            </div>
                            <span asp-validation-for="Pincode" class="field-validation"></span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- =================================================
                 SUBMIT AREA
            ================================================== -->
            <div class="registration-actions">
                <div class="login-existing">
                    <span>Already registered?</span>
                    <a asp-controller="Account" asp-action="Login">
                        Login here <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
                <button type="submit" class="register-submit">
                    <i class="fa-solid fa-user-shield"></i>
                    Create Admin Account
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>

            <!-- NOTE -->
            <div class="registration-note">
                <i class="fa-solid fa-circle-info"></i>
                <span>
                    Fields marked with <strong>*</strong> are mandatory. Please make sure that all information entered is accurate before submitting the registration form.
                </span>
            </div>
        </form>
    </div>
</div>

<!-- =========================================================
     PAGE JAVASCRIPT
========================================================= -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        /* =====================================================
           PASSWORD SHOW / HIDE
        ===================================================== */
        function togglePassword(fieldId, button) {
            const field = document.getElementById(fieldId);
            const icon = button.querySelector("i");

            if (!field) return;

            if (field.type === "password") {
                field.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
                button.setAttribute("aria-label", "Hide password");
            } else {
                field.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
                button.setAttribute("aria-label", "Show password");
            }
        }
        /* =====================================================
           ONLY ALLOW NUMBERS
        ===================================================== */
        const numericFields = ["AadhaarNo", "MobileNo", "Pincode"];

        numericFields.forEach(function (fieldName) {
            const field = document.querySelector('[name="' + fieldName + '"]');
            if (field) {
                field.addEventListener("input", function () {
                    this.value = this.value.replace(/\D/g, "");
                });
            }
        });
    </script>
}