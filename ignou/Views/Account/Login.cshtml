@model ignou.Models.LoginViewModel

@{
    ViewData["Title"] = "VMOU Account Login";
}

<link rel="stylesheet"
      href="~/css/Login.css"
      asp-append-version="true" />

<div class="login-page">

    <div class="login-container">

        <!-- Welcome Header -->
        <div class="login-heading">

            <div class="login-brand-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <h1>Welcome Back</h1>

            <p>Sign in to continue to your account.</p>

        </div>

        <!-- Login Card -->
        <div class="login-card">

            <!-- Card Header -->
            <div class="login-card-header">

                <div class="login-header-icon">
                    <i class="fa-solid fa-right-to-bracket"></i>
                </div>

                <div>
                    <h2>VMOU Account Login</h2>
                    <p>Enter your account credentials to continue.</p>
                </div>

            </div>

            <!-- Login Form -->
            <div class="login-card-body">

                <form asp-action="Login"
                      asp-controller="Account"
                      method="post"
                      autocomplete="on">

                    @Html.AntiForgeryToken()

                    <!-- Validation Summary -->
                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary"
                         role="alert">
                    </div>

                    <!-- Email -->
                    <div class="form-field">

                        <label asp-for="Email">
                            Email Address <span>*</span>
                        </label>

                        <div class="input-wrapper">

                            <i class="fa-regular fa-envelope"></i>

                            <input asp-for="Email"
                                   class="form-control-custom"
                                   type="email"
                                   placeholder="Enter your email address"
                                   autocomplete="username" />

                        </div>

                        <span asp-validation-for="Email"
                              class="field-validation">
                        </span>

                    </div>

                    <!-- Password -->
                    <div class="form-field">

                        <label asp-for="Password">
                            Password <span>*</span>
                        </label>

                        <div class="input-wrapper password-wrapper">

                            <i class="fa-solid fa-lock"></i>

                            <input asp-for="Password"
                                   id="loginPassword"
                                   class="form-control-custom"
                                   type="password"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />

                            <button type="button"
                                    class="password-toggle"
                                    id="loginPasswordToggle"
                                    aria-label="Show password"
                                    aria-controls="loginPassword">

                                <i class="fa-regular fa-eye"></i>

                            </button>

                        </div>

                        <span asp-validation-for="Password"
                              class="field-validation">
                        </span>

                    </div>

                    <!-- Login Button -->
                    <button type="submit" class="login-submit">

                        <i class="fa-solid fa-right-to-bracket"></i>

                        <span>Sign In</span>

                    </button>

                    <!-- Register Link -->
                    <div class="login-register-link">

                        <span>Don't have an account?</span>

                        <a asp-controller="Account"
                           asp-action="Register">

                            Create Account
                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>

                </form>

            </div>

        </div>

        <!-- Security Information -->
        <div class="login-security-note">

            <div class="login-security-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div>
                <strong>Secure Login</strong>

                <span>
                    Your login credentials are securely processed
                    by the VMOU portal.
                </span>
            </div>

        </div>

        <!-- Footer -->
        <div class="login-footer-text">

            <i class="fa-solid fa-graduation-cap"></i>

            <span>VMOU Account Access</span>

            <span class="footer-separator">•</span>

            <span>Secure Sign In</span>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const passwordInput =
                document.getElementById("loginPassword");

            const passwordToggle =
                document.getElementById("loginPasswordToggle");

            if (!passwordInput || !passwordToggle) {
                return;
            }

            passwordToggle.addEventListener("click", function () {

                const icon = passwordToggle.querySelector("i");

                if (passwordInput.type === "password") {

                    passwordInput.type = "text";

                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");

                    passwordToggle.setAttribute(
                        "aria-label",
                        "Hide password"
                    );

                } else {

                    passwordInput.type = "password";

                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");

                    passwordToggle.setAttribute(
                        "aria-label",
                        "Show password"
                    );
                }

            });

        });
    </script>

}