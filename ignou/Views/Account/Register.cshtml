@model ignou.Models.RegisterViewModel
@{
    ViewData["Title"] = "Student Registration";
}

<div class="container mt-4">
    <h2 class="mb-4">New Student Registration</h2>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- 1. Personal Details -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">Personal Details</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label>Full Name</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Father's Name</label>
                        <input asp-for="FatherName" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Date of Birth</label>
                        <input asp-for="DOB" type="date" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Gender</label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Category</label>
                        <select asp-for="Category" class="form-select">
                            <option value="">Select Category</option>
                            <option value="General">General</option>
                            <option value="OBC">OBC</option>
                            <option value="SC">SC</option>
                            <option value="ST">ST</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Blood Group</label>
                        <select asp-for="BloodGroup" class="form-select">
                            <option value="">Select Blood Group</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="O+">O+</option>
                            <option value="AB+">AB+</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Marital Status</label>
                        <select asp-for="MaritalStatus" class="form-select">
                            <option value="Single">Single</option>
                            <option value="Married">Married</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Personal Disability</label>
                        <select asp-for="PersonalDisability" class="form-select">
                            <option value="No">No</option>
                            <option value="Yes">Yes</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Aadhaar Number</label>
                        <input asp-for="AadhaarNo" class="form-control" />
                        <span asp-validation-for="AadhaarNo" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Contact Details -->
        <div class="card mb-4">
            <div class="card-header bg-secondary text-white">Contact & Login Details</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label>Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Mobile Number</label>
                        <input asp-for="MobileNo" class="form-control" />
                        <span asp-validation-for="MobileNo" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Password</label>
                        <input asp-for="Password" type="password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Address Details -->
        <div class="card mb-4">
            <div class="card-header bg-info text-white">Address Details</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label>House / Street Address</label>
                        <input asp-for="House" class="form-control" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label>City</label>
                        <input asp-for="City" class="form-control" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label>District</label>
                        <input asp-for="District" class="form-control" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label>State</label>
                        <input asp-for="State" class="form-control" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label>Pincode</label>
                        <input asp-for="Pincode" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Programme Details -->
        <div class="card mb-4">
            <div class="card-header bg-success text-white">Programme Details</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label>Programme Type</label>
                        <select asp-for="ProgramType" class="form-select" id="programTypeSelect" onchange="populatePrograms()">
                            <option value="">Select Type</option>
                            <option value="Bachelor Degree">Bachelor Degree</option>
                            <option value="Master Degree">Master Degree</option>
                            <option value="Diploma">Diploma</option>
                        </select>
                        <span asp-validation-for="ProgramType" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label>Programme Name</label>
                        <select asp-for="ProgramName" class="form-select" id="programNameSelect">
                            <option value="">Select Programme First</option>
                        </select>
                        <span asp-validation-for="ProgramName" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg mb-5 w-100">Submit Registration</button>
    </form>
</div>

<!-- JavaScript for Dynamic Dropdown -->
<script>
    const programData = {
        "Bachelor Degree": ["BCA", "BA", "BSc", "BCom", "BBA"],
        "Master Degree": ["MCA", "MA", "MSc", "MCom", "MBA"],
        "Diploma": ["PGDCA", "Diploma in IT", "Diploma in Management"]
    };

    function populatePrograms() {
        const typeSelect = document.getElementById("programTypeSelect");
        const nameSelect = document.getElementById("programNameSelect");
        const selectedType = typeSelect.value;

        // Clear existing options
        nameSelect.innerHTML = '<option value="">Select Programme Name</option>';

        if (selectedType && programData[selectedType]) {
            const programs = programData[selectedType];
            programs.forEach(prog => {
                let option = document.createElement("option");
                option.value = prog;
                option.text = prog;
                nameSelect.appendChild(option);
            });
        }
    }
</script>